<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Construi-AI 3.0</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(135deg,#071a16,#123d32);color:#f5fff9}header{text-align:center;padding:28px 16px;border-bottom:1px solid #ffffff20}.logo{font-size:31px;font-weight:900}.logo span{color:#67e3a7}.tag{color:#c5d9d1;max-width:780px;margin:8px auto;line-height:1.5}.wrap{max-width:1150px;margin:auto;padding:18px}.grid{display:grid;grid-template-columns:390px 1fr;gap:18px}.card{background:#0b211c;border:1px solid #ffffff18;border-radius:20px;padding:19px;box-shadow:0 12px 35px #0004}h2{margin-top:0}h3{color:#aef2ce}label{display:block;font-size:13px;color:#c9ddd5;margin:11px 0 6px}input,select,textarea{width:100%;padding:11px;border-radius:10px;border:1px solid #ffffff22;background:#06140f;color:white}.row,.checks{display:grid;grid-template-columns:1fr 1fr;gap:8px}.check{margin:0;background:#071812;padding:9px;border-radius:9px}.check input{width:auto}button{width:100%;padding:13px;margin-top:12px;border:0;border-radius:11px;background:#67e3a7;color:#052016;font-weight:800;font-size:15px}button.secondary{background:#17372d;color:white}.upload{border:1px dashed #67e3a766;padding:16px;border-radius:13px;text-align:center;background:#071812}.preview{display:none;max-height:250px;width:100%;object-fit:contain;margin-top:10px;border-radius:10px}.status{background:#071812;padding:10px;border-radius:10px;margin-top:9px;color:#c8ddd4;font-size:12px;line-height:1.5}.empty{min-height:560px;display:flex;align-items:center;justify-content:center;text-align:center;color:#9eb6ac}.hidden{display:none}.badge{display:inline-block;padding:6px 10px;border-radius:99px;background:#67e3a722;color:#7deeb0;font-size:11px}.summary{padding:14px;background:#071812;border-radius:12px;line-height:1.6;color:#d7e8e1}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}.metric{background:#102d25;padding:11px;border-radius:11px;text-align:center;font-size:12px}.metric b{display:block;color:#7deeb0;font-size:18px}.rooms{display:grid;grid-template-columns:1fr 1fr;gap:8px}.room{background:#102d25;border:1px solid #ffffff12;border-radius:11px;padding:11px;font-size:13px}.room b{display:block;color:#7deeb0;margin-bottom:4px}.plan{background:#eeeae0;color:#18201d;border-radius:15px;padding:13px;margin-top:15px}.plan-grid{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:54px;border:3px solid #18201d;max-width:700px;margin:auto}.cell{border:1px solid #18201d;display:flex;align-items:center;justify-content:center;text-align:center;font-size:10px;font-weight:800}.s1{grid-column:span 1}.s2{grid-column:span 2}.s3{grid-column:span 3}.s4{grid-column:span 4}.small{font-size:11px;color:#8fa89e;line-height:1.5}footer{text-align:center;padding:25px;color:#718b80;font-size:12px}@media(max-width:850px){.grid{grid-template-columns:1fr}.rooms{grid-template-columns:1fr}.wrap{padding:12px}}
</style>
</head>
<body>
<header><div class="logo">🏠 Construi-<span>AI</span> 3.0</div><div class="tag">Laboratório de arquitetura: transforme medidas, ideias e croquis em uma simulação conceitual de projeto.</div></header>
<div class="wrap"><div class="grid">
<section class="card">
<h2>🧱 Criar projeto</h2>
<label>Nome do projeto</label><input id="nome" placeholder="Ex.: Casa Horizonte">
<label>Terreno (m)</label><div class="row"><input id="largura" type="number" placeholder="Largura"><input id="comprimento" type="number" placeholder="Comprimento"></div>
<label>Área construída desejada (m²)</label><input id="area" type="number" placeholder="Ex.: 180">
<label>Quartos / banheiros</label><div class="row"><input id="quartos" type="number" value="3"><input id="banheiros" type="number" value="2"></div>
<label>Estilo</label><select id="estilo"><option>Moderno</option><option>Contemporâneo</option><option>Minimalista</option><option>Rústico</option><option>Clássico</option></select>
<label>Programa</label><div class="checks">
<label class="check"><input id="sala" type="checkbox" checked> 🛋️ Sala</label><label class="check"><input id="cozinha" type="checkbox" checked> 🍳 Cozinha</label>
<label class="check"><input id="suite" type="checkbox"> 🛏️ Suíte</label><label class="check"><input id="piscina" type="checkbox"> 🏊 Piscina</label>
<label class="check"><input id="gourmet" type="checkbox"> 🔥 Gourmet</label><label class="check"><input id="lavanderia" type="checkbox"> 🧺 Lavanderia</label>
<label class="check"><input id="garagem" type="checkbox"> 🚗 Garagem</label><label class="check"><input id="jardim" type="checkbox"> 🌿 Jardim</label>
</div>
<h3>📷 Croqui</h3><div class="upload"><input id="croqui" type="file" accept="image/*"><p class="small">Envie uma foto do seu croqui para visualizar. A análise real por IA será adicionada na próxima etapa com backend.</p><img id="preview" class="preview"></div>
<label>Descrição da ideia</label><textarea id="obs" rows="4" placeholder="Ex.: conceito aberto, quartos reservados e gourmet voltado para a piscina."></textarea>
<button onclick="simular()">✨ Gerar simulação</button><button class="secondary" onclick="location.reload()">↺ Limpar projeto</button>
<div id="status" class="status" style="display:none"></div>
</section>
<section class="card">
<div id="empty" class="empty"><div><div style="font-size:58px">🏗️</div><h2>Pronto para projetar?</h2><p>Preencha os dados e gere uma proposta conceitual.</p></div></div>
<div id="out" class="hidden"><span class="badge">CONCEITO GERADO</span><h2 id="titulo"></h2><div id="metrics" class="metrics"></div><div id="summary" class="summary"></div>
<h3>📋 Ambientes sugeridos</h3><div id="rooms" class="rooms"></div>
<div class="plan"><div style="text-align:center;font-weight:900;margin-bottom:8px">Croqui conceitual — não executivo</div><div id="plan" class="plan-grid"></div></div>
<p class="small">⚠️ Simulação educacional/conceitual. Não substitui projeto arquitetônico, estrutural, elétrico, hidráulico, aprovação ou dimensionamento profissional.</p>
</div>
</section></div></div><footer>Construi-AI 3.0 • Simulador conceitual de construção e arquitetura</footer>
<script>
const $=x=>document.getElementById(x),V=(x,d='')=>$(x).value||d,C=x=>$(x).checked;
$('croqui').onchange=e=>{let f=e.target.files[0];if(!f)return;let im=$('preview');im.src=URL.createObjectURL(f);im.style.display='block';$('status').style.display='block';$('status').innerHTML='📷 Croqui carregado: <b>'+f.name+'</b><br>Pronto para a próxima etapa de análise por IA.'};
function simular(){
let nome=V('nome','Projeto Construi-AI'),l=+V('largura',0),c=+V('comprimento',0),a=+V('area',0),q=+V('quartos',3),b=+V('banheiros',2),est=V('estilo'),ter=l*c;
$('empty').classList.add('hidden');$('out').classList.remove('hidden');$('titulo').textContent=nome;
$('metrics').innerHTML='<div class="metric"><b>'+(ter?ter.toFixed(0):'—')+'</b>m² terreno</div><div class="metric"><b>'+(a||'—')+'</b>m² casa</div><div class="metric"><b>'+q+' + '+b+'</b>quartos + banheiros</div>';
let s='Proposta em estilo '+est.toLowerCase()+'. '+(ter?'Terreno de '+l+' × '+c+' m ('+ter.toFixed(0)+' m²). ':'')+(a?'Área de referência: '+a+' m². ':'')+(C('sala')&&C('cozinha')?'Sala e cozinha podem formar um núcleo social integrado. ':'')+(C('piscina')?'A área de lazer foi considerada voltada ao exterior. ':'')+'Foram considerados '+q+' quarto(s) e '+b+' banheiro(s).';$('summary').textContent=s;
let r=[];if(C('garagem'))r.push(['🚗 Garagem','Acesso frontal e manobra.']);if(C('jardim'))r.push(['🌿 Jardim','Área verde e transição.']);r.push(['🚪 Entrada','Acesso principal.']);if(C('sala'))r.push(['🛋️ Sala','Convivência e integração.']);if(C('cozinha'))r.push(['🍳 Cozinha','Próxima da área social.']);for(let i=1;i<=q;i++)r.push([i==1&&C('suite')?'🛏️ Suíte':'🛏️ Quarto '+i,i==1&&C('suite')?'Maior privacidade.':'Dormitório flexível.']);for(let i=1;i<=b;i++)r.push(['🚿 Banheiro '+i,'Distribuição funcional.']);if(C('lavanderia'))r.push(['🧺 Lavanderia','Setor de serviço.']);if(C('gourmet'))r.push(['🔥 Área gourmet','Integração com lazer.']);if(C('piscina'))r.push(['🏊 Piscina','Área externa de lazer.']);
$('rooms').innerHTML=r.map(x=>'<div class="room"><b>'+x[0]+'</b>'+x[1]+'</div>').join('');
let p=$('plan');p.innerHTML='';[['Garagem','s2'],['Jardim','s4'],['Entrada','s2'],['Sala','s2'],['Cozinha','s2'],['Quarto','s2'],['Quarto','s2'],['Banheiro','s2'],['Suíte / Quarto','s3'],['Banheiro','s1'],['Lavanderia','s2'],['Gourmet','s3'],['Piscina / Jardim','s3']].forEach(x=>{let d=document.createElement('div');d.className='cell '+x[1];d.textContent=x[0];p.appendChild(d)});window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body></html>
